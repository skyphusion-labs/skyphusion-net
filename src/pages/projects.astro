---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS, type Project } from '../lib/projects';
import { breadcrumbJsonLd, projectsJsonLd, siteOrigin, tagPath } from '../lib/seo';

const site = Astro.site?.href ?? 'https://skyphusion.net';
const origin = siteOrigin(site);
// A tag page exists only for tags that some published post carries; any other project tag is
// shown as plain text, so the page never links a 404 (skyphusion-net#153).
// The links a card shows, in a fixed order; a card with no public source shows none of GitHub.
function linksOf(p: Project): { label: string; url: string }[] {
  return [
    p.site ? { label: 'Website', url: p.site } : null,
    p.demo ? { label: 'Live demo', url: p.demo } : null,
    p.repo ? { label: 'GitHub', url: p.repo } : null,
    ...(p.more ?? []),
    p.post ? { label: 'Write-up', url: p.post } : null,
  ].filter((x): x is { label: string; url: string } => x !== null);
}
const postTags = new Set((await getCollection('blog', ({ data }) => !data.draft)).flatMap((p) => p.data.tags ?? []));
const jsonLd = [
  projectsJsonLd(site, PROJECTS),
  breadcrumbJsonLd([
    { name: 'Home', url: `${origin}/` },
    { name: 'Projects', url: `${origin}/projects/` },
  ]),
];
---
<BaseLayout
  title="Open source projects from Skyphusion Labs"
  description="Open source from Skyphusion Labs: Postern email for humans and agents, the Vivijure AI film studio, Prism, Skyphusion AI for WordPress, and more."
  jsonLd={jsonLd}
>
  <h1>Projects</h1>
  <p class="intro">
    Open source tools from <a href="https://skyphusion.org">Skyphusion Labs</a> and
    <a href="https://github.com/skyphusion-labs">github.com/skyphusion-labs</a>, built on Cloudflare Workers,
    self-hosted GPU, and boring infrastructure. Flagship:
    <a href="https://vivijure.dev">Vivijure</a>, a free AGPL-3.0 AI film studio.
    Write-ups are linked on the projects that have one.
  </p>

  <ul class="project-list">
    {PROJECTS.map((project) => (
      <li>
        <h2>{project.name}</h2>
        <p class="description">{project.description}</p>
        {project.status && <p class="status">{project.status}</p>}
        {linksOf(project).length > 0 && (
          <p class="links">
            {linksOf(project).map((link, i) => (
              <>
                {i > 0 && <span class="sep">/</span>}
                <a href={link.url}>{link.label}</a>
              </>
            ))}
          </p>
        )}
        {project.tags.length > 0 && <p class="tags">
          {project.tags.map((tag) =>
            postTags.has(tag) ? (
              <a href={tagPath(tag)} class="tag">#{tag}</a>
            ) : (
              <span class="tag">#{tag}</span>
            )
          )}
        </p>}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    color: var(--muted);
    margin-top: -0.25rem;
  }
  .project-list {
    list-style: none;
    padding: 0;
  }
  .project-list li {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .project-list li:last-child {
    border-bottom: none;
  }
  .project-list h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
  }
  .description {
    margin: 0 0 0.75rem 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .links {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
  }
  .sep {
    color: var(--border);
    margin: 0 0.5rem;
  }
  .status {
    display: inline-block;
    margin: 0 0 0.75rem 0;
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.125rem 0.5rem;
  }
  .tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tag {
    background: var(--code-bg);
    border: 1px solid var(--border);
    padding: 0.125rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
  }
  .tag:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>
